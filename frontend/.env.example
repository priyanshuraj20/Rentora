# ==========================================
# RENTORA FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env in the frontend folder:
# cp .env.example .env

# Backend API Base URL
VITE_BACKEND_URL=http://localhost:3000

# Cloudinary (Direct unsigned upload from client)
# Format: https://api.cloudinary.com/v1_1/<your_cloud_name>/image/upload
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
# Unsigned upload preset created in Cloudinary Dashboard -> Settings -> Upload -> Upload Presets
VITE_CLOUDINARY_PRESET=rentora_preset

# Optional Firebase Config (if using client-side Firebase push notifications/auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
