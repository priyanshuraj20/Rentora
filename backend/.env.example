# ==========================================
# RENTORA BACKEND ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env in the backend folder:
# cp .env.example .env

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rentora?retryWrites=true&w=majority

# Redis (for BullMQ background jobs & token blacklisting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_min_10_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_min_10_chars
QR_TOKEN_SECRET=your_super_secret_qr_token_key_here_min_10_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_SECRET=your_express_session_secret_min_20_chars_long

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Razorpay (Razorpay Dashboard -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ElasticSearch (Elastic Cloud or Bonsai / Local)
ELASTIC_SEARCH_URL=https://your-elastic-deployment.es.io:9243
ELASTIC_API_KEY=your_elasticsearch_api_key

# Cloudinary (Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP / Resend (for OTP & booking alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_USER=your_email@gmail.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional Monitoring
SENTRY_DSN=
